        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3,12 H7.22 L8.79,7.95 L11.15,14.93 L13.29,10.76 L14.48,12 H21" />
