<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network + push -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Foreground service for self-hosted SSE socket -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- Phone mode: the on-device omp daemon runs in a specialUse foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Keep CPU briefly while processing notify ping -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Restart after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 13+ runtime permission — no install-time effect pre-33 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Native MediaRecorder dictation uploads to /api/transcribe. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Phone mode: the agent works on the user's files (/sdcard in the guest).
         All-files access on 11+, the legacy pair below that. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- Phone mode: the agent installs, removes and launches apps on request. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Phone mode: Doze would otherwise suspend a running agent with the screen off. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Native libraries are extracted to nativeLibraryDir by build.gradle
         (useLegacyPackaging = extractNativeLibs="true"; AGP flags the
         attribute in a source manifest). networkSecurityConfig: cleartext
         only to loopback, where the on-device daemon and debug test daemons
         listen. -->
    <application
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme.NoActionBar">
        <meta-data
            android:name="com.omppulse.app.RELEASE_ID"
            android:value="${ompPulseReleaseId}" />
        <meta-data
            android:name="com.omppulse.app.PROTOCOL_VERSION"
            android:value="${ompPulseProtocolVersion}" />
        <meta-data
            android:name="com.omppulse.app.MIN_CLIENT_PROTOCOL_VERSION"
            android:value="${ompPulseMinClientProtocolVersion}" />

        <!-- Cross-package transfer accepts a granted content URI, but only this APK's
             signing key can authorise archive contents and the loopback receipt. -->
        <activity
            android:name=".runtime.ConversationImportActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".runtime.ConversationImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press the app icon › "Choose where to run": an escape from
                 any page a computer serves (unpaired, unreachable, stale),
                 handled natively, so it works whatever that page shows. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="omppulse" />
            </intent-filter>
        </activity>

        <!-- https links to the baked laptop's /app/ open the shell. A manifest
             cannot omit an element by placeholder, so the filter lives on an
             alias that build.gradle disables when OMP_PULSE_SERVER_URL is unset
             (public build: no host to claim). -->
        <activity-alias
            android:name=".ServerLinkActivity"
            android:targetActivity=".MainActivity"
            android:enabled="${ompPulseServerLinks}"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${ompPulseServerHost}" android:pathPrefix="/app/" />
            </intent-filter>
        </activity-alias>

        <!-- Bubble target — must be resizeable + allowEmbedded per bubble spec -->
        <activity
            android:name=".BubbleActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="true"
            android:allowEmbedded="true"
            android:resizeableActivity="true"
            android:documentLaunchMode="always" />

        <!-- Foreground service holding SSE connection.
             INVARIANT: targetSdk 34 mandates foregroundServiceType and the
             startForeground() call must pass the same type or the system throws.
             remoteMessaging carries desktop chat continuity on Android 14+;
             dataSync is used only on older versions without the daily quota. -->
        <service
            android:name=".NotifyService"
            android:exported="false"
            android:foregroundServiceType="dataSync|remoteMessaging" />

        <!-- Phone mode: supervises the on-device omp daemon and the phone API.
             specialUse is the only type that fits a user-started local agent
             server, and unlike dataSync it may start from BOOT_COMPLETED. -->
        <service
            android:name=".runtime.LocalPulseService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the omp coding agent and its local server on this device" />
        </service>

        <!-- Phone mode: lets the on-device agent read and operate the screen.
             BIND_ACCESSIBILITY_SERVICE restricts binding to the system. -->
        <service
            android:name=".phone.PhoneAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/phone_accessibility" />
        </service>

        <service
            android:name=".NativeOutboxJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false" />

        <!-- Home-screen widget: New chat + latest chats. Exported because the
             launcher's widget host delivers APPWIDGET_UPDATE; it only refreshes. -->
        <receiver
            android:name=".PulseWidget"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pulse_widget_info" />
        </receiver>

        <!-- Restart service after reboot / update if a token exists -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

</manifest>
