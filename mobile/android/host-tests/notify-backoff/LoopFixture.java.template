    private static final class FakeRandom {
        int nextInt(int bound) {
            if (bound != 700) throw new AssertionError("jitter bound changed");
            return jitterValue;
        }
    }
    private static final class Thread {
        private static boolean interrupted;
        static boolean interrupted() { boolean result = interrupted; interrupted = false; return result; }
        static Thread currentThread() { return active.sseThread; }
        void interrupt() { interrupted = true; }
        static void sleep(long ms) throws InterruptedException {
            active.sleeps.add(ms);
            long started = now;
            advanceTo(now + ms);
            active.elapsedSleeps.add(now - started);
            if (wakeReason != null) active.reconnectNow(wakeReason);
            if (active.opened == active.attempts.size()) active.shouldRun.set(false);
            if (interruptSleep || interrupted) throw new InterruptedException("synthetic wake");
        }
    }
    // JSON is a narrow platform boundary here, not a substitute Android parser.
    // Matrix payloads are deliberately limited to an object and invalid shapes.
    private static final class JSONObject {
        final String data;
        JSONObject(String data) {
            if (!"{}".equals(data)) throw new IllegalArgumentException("synthetic invalid object");
            this.data = data;
        }
    }
    private static final class NotificationHelper {
        static void postFromPayload(LoopFixture fixture, JSONObject object) {
            fixture.events.add(object.data);
            now += postDelay;
            if (postFailure) throw new IllegalStateException("synthetic posting failure");
        }
    }

