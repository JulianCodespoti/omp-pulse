    private static void migratedQueuesRemainEditable() throws Exception {
        for(String[] absent:new String[][]{
                {"receipt_binding","receipt_revision","delivery","edit_token"},
                {"delivery","edit_token"}, {"receipt_binding","receipt_revision","edit_token"},
                {"edit_token"}, {}}) {
            reset(); insert(CONTEXT,ORIGIN,namespace,photoCommand(),false,false,Long.MAX_VALUE);
            List<String> old=new ArrayList<>(COMMAND_COLUMNS); old.removeAll(Arrays.asList(absent));
            DB.schema.put("commands",old);
            Helper helper=new Helper(CONTEXT); helper.onUpgrade(DB,1,DATABASE_VERSION);
            JSONObject restored=editBegin(CONTEXT,namespace,ORIGIN,ID,get(CONTEXT,namespace,ORIGIN,ID),Long.MAX_VALUE);
            check("legacy queue upgrades without losing its editable photo "+Arrays.toString(absent),
                    restored.optJSONArray("images").getJSONObject(0).getString("data").equals("AQID")
                    && restored.optJSONObject("entry").getString("text").equals(command(ID).getString("text")));
        }
