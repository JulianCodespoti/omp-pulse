    private static void routingAndStatus() throws Exception {
        reset(); JSONObject ack=enqueue(CONTEXT,namespace,ORIGIN,command(ID),false,Long.MAX_VALUE);
        check("new save acknowledged and wakes delivery once",ack!=null && wakes==1 && STATUS.queued.isEmpty());
        wakes=0; ack=enqueue(CONTEXT,namespace,ORIGIN,command(ID),false,Long.MAX_VALUE);
        check("duplicate saved postable row retains first-send behavior",ack!=null && wakes==1 && DB.tables.get("commands").size()==1);
        for(String state:new String[]{"uncertain","accepted","dispatching","received","running","saved"}) {
            reset(); seed(state,false,false); String before=snapshot();
            ack=enqueue(CONTEXT,namespace,ORIGIN,command(ID),false,Long.MAX_VALUE);
            check(state+" status returns durable ack before network",ack!=null && gets==0 && STATUS.queued.size()==1 && snapshot().equals(before));
            noDelivery(state+" queued"); STATUS.runAll();
            check(state+" targeted receipt commits terminal proof",gets==1 && intent().state.equals("completed") && intent().revision==1 && intent().binding!=null && !intent().mayPost);
            noDelivery(state+" finished");
            HttpURLConnection c=connections.get(0);
            check(state+" exact raw scope encoded with exact ID",c.url.equals(ORIGIN+"/api/receipts/"+URLEncoder.encode(ID,"UTF-8")+"?session="+URLEncoder.encode(RAW,"UTF-8")));
            check(state+" HTTP caches disabled and bounded",!c.useCaches && "no-store".equals(c.headers.get("Cache-Control")) && !c.redirects && c.connectTimeout>0 && c.connectTimeout<=15000 && c.readTimeout>0 && c.readTimeout<=20000 && c.disconnected);
        }
        for(String state:new String[]{"completed","forwarded","failed"}) {
            reset(); seed(state,false,false); ack=enqueue(CONTEXT,namespace,ORIGIN,command(ID),false,Long.MAX_VALUE);
            check(state+" duplicate immediate ack without queued work",ack!=null && STATUS.queued.isEmpty() && gets==0); noDelivery(state+" terminal");
        }
        for(String retained:new String[]{"receipt","receipt_binding"}) {
            reset(); seed("saved",true,false);
