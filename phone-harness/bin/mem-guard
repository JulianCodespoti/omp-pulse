#!/usr/bin/env python3
"""Keep the guest from getting omp-pulse killed by Android's low-memory killer.

Everything in this Linux guest runs inside the omp-pulse app's process
group. When a build or test run (rustc, node, chromium, java) pushes the
phone into memory pressure, Android's lmkd kills the whole app: the daemon,
every agent turn and every server you started. On a reference phone (~11 GB MemTotal),
app restarts matched heavy guest jobs; a failing node test assert climbed to
6 GB in ~10 s.

This guard sacrifices the job instead of the app. Every 1-3 s (`pause`) it:
- renices any killable job of RSS+swap >= RENICE_MB to nice 19 (all threads),
  so the daemon and agents stay responsive while it runs;
- SIGKILLs any killable job >= MAX_JOB_MB, whatever memory is free (a runaway
  grows ~600 MB/s and would otherwise reach the floor below in seconds);
- when MemAvailable < MIN_AVAIL_MB, SIGKILLs the largest killable job
  >= MIN_VICTIM_MB.
The thresholds were tuned on the reference phone (1 GB, 3 GB, 1 GB, 400 MB)
and scale linearly with this phone's MemTotal, rounded to 100 MB, with floors;
`mem-guard --help` prints the values in force here.
Never killed or reniced: the daemon, its sh wrapper, proot, omp (agents and
broker), phone-mcp and this guard. Kills are logged and notified; a memory
sample is logged every 30 s so the next restart has evidence:
$STATE/mem-guard.log.

Not started automatically: start it in the background before heavy work
(`/root/projects/phone-harness/bin/mem-guard </dev/null >/dev/null 2>&1 &`); a second instance
exits at once.
"""
import fcntl, os, signal, subprocess, sys, time

STATE = "/root/.local/state/omp-pulse"
LOG = f"{STATE}/mem-guard.log"
LOG_MAX = 1 << 20     # rotate to .old past 1 MB
REF_MEMTOTAL_MB = 11113  # MemTotal of the reference phone the thresholds were tuned on (~11 GB)


def scaled_mb(reference_mb, floor_mb, memtotal_mb):
    """REFERENCE_MB (tuned at REF_MEMTOTAL_MB) scaled linearly to MEMTOTAL_MB, rounded to 100 MB, >= FLOOR_MB."""
    return max(floor_mb, int(round(reference_mb * memtotal_mb / REF_MEMTOTAL_MB / 100.0)) * 100)


def memtotal_mb():
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    return int(line.split()[1]) // 1024
    except (OSError, ValueError, IndexError):
        pass
    return REF_MEMTOTAL_MB


def thresholds(memtotal):
    """{name: MB} for a phone with MEMTOTAL MB; the reference phone gets exactly the tuned values."""
    return {
        # Act only on real pressure. Swap is shared with every app and sat at 15-25% free with
        # 3 GB available for hours on the reference phone, so it is logged, not a trigger.
        "MIN_AVAIL_MB": scaled_mb(1000, 500, memtotal),   # MemAvailable floor
        "MIN_VICTIM_MB": scaled_mb(400, 200, memtotal),   # never kill small jobs (test runs, editors)
        "RENICE_MB": scaled_mb(1000, 500, memtotal),      # jobs this big drop to nice 19
        "MAX_JOB_MB": scaled_mb(3000, 1500, memtotal),    # no single killable job may grow past this
    }


MEMTOTAL_MB = memtotal_mb()
_T = thresholds(MEMTOTAL_MB)
MIN_AVAIL_MB, MIN_VICTIM_MB, RENICE_MB, MAX_JOB_MB = (_T[k] for k in ("MIN_AVAIL_MB", "MIN_VICTIM_MB", "RENICE_MB",
                                                                      "MAX_JOB_MB"))
# Fastest growth seen (a node test assert on the reference phone). The next check comes
# before a job growing this fast could cross MAX_JOB_MB or push MemAvailable
# under the floor; with nothing near either line that is ~3 s, not 1 s, and
# every check costs ~15 opens that proot traps (~100 us of its time each).
GROWTH_MB_S = 600
MIN_SLEEP = 1.0      # most headroom (no job >= RENICE_MB): (MAX_JOB_MB - RENICE_MB) / GROWTH_MB_S
# Never killed or reniced: executables (basename of argv[0], plus any
# omp-pulse* daemon build) and scripts (anywhere in argv).
PROTECT_EXE = ("omp", "sh", "libproot.so", "libomppulse.so")
PROTECT_ARG = ("/bin/mem-guard", "/bin/phone-mcp")
# Killable but not reniced: dictation must stay fast.
NO_RENICE_ARG = ("asr-server.py",)
PAGE_MB = os.sysconf("SC_PAGE_SIZE") / (1 << 20)


def usage():
    return (__doc__.strip() + f"\n\nThis phone: MemTotal {MEMTOTAL_MB} MB -> renice >= {RENICE_MB} MB, "
            f"kill >= {MAX_JOB_MB} MB, low-memory kill when MemAvailable < {MIN_AVAIL_MB} MB "
            f"(largest job >= {MIN_VICTIM_MB} MB).")


def slurp(path):
    """Read a small /proc file. proot traps the open and close (~100 us each); the read is free."""
    fd = os.open(path, os.O_RDONLY)
    try:
        return os.read(fd, 8192)
    finally:
        os.close(fd)


def meminfo():
    out = {}
    for line in slurp("/proc/meminfo").decode().splitlines():
        k, v = line.split(":", 1)
        out[k] = int(v.split()[0]) // 1024
    return out


def log(msg):
    try:
        if os.path.getsize(LOG) > LOG_MAX:
            os.replace(LOG, LOG + ".old")
    except OSError:
        pass
    with open(LOG, "a") as f:
        f.write(time.strftime("%FT%T ") + msg + "\n")


def protected(cmd):
    exe = cmd.split(" ", 1)[0].rsplit("/", 1)[-1]
    return exe in PROTECT_EXE or exe.startswith("omp-pulse") or any(p in cmd for p in PROTECT_ARG)


def jobs(min_mb):
    """Killable processes with RSS+swap >= min_mb, as (MB, pid, cmd).

    Reads only statm for the rest, so the per-second scan stays ~2 ms."""
    me = os.getpid()
    for pid in os.listdir("/proc"):
        if not pid.isdigit() or int(pid) == me:
            continue
        try:
            if int(slurp(f"/proc/{pid}/statm").split()[1]) * PAGE_MB * 2 < min_mb:
                continue  # even with as much again in swap it is too small
            size = 0
            for line in slurp(f"/proc/{pid}/status").split(b"\n"):
                if line.startswith((b"VmRSS:", b"VmSwap:")):
                    size += int(line.split()[1]) // 1024
            cmd = slurp(f"/proc/{pid}/cmdline").replace(b"\0", b" ").decode(errors="replace").strip()
        except (OSError, IndexError, ValueError):
            continue
        if size >= min_mb and cmd and not protected(cmd):
            yield size, int(pid), cmd


def kill(size, pid, cmd, why):
    try:
        os.kill(pid, signal.SIGKILL)
    except OSError:
        return
    log(f"KILLED pid={pid} {size}MB ({why}) :: {cmd[:160]}")
    name = cmd.split(" ", 1)[0].rsplit("/", 1)[-1]
    try:
        subprocess.Popen(["android", "notify", "Stopped a heavy job",
                          f"{why}: stopped {name} ({size} MB) so Android would not close omp-pulse."],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def renice(pid, size, cmd):
    try:
        for tid in os.listdir(f"/proc/{pid}/task"):
            os.setpriority(os.PRIO_PROCESS, int(tid), 19)
    except OSError:
        return
    log(f"reniced pid={pid} {size}MB :: {cmd[:160]}")


def pause(avail, biggest):
    """Seconds until the next check: before a job of `biggest` MB (the largest
    killable job left alive; jobs() never reports one under RENICE_MB) growing at
    GROWTH_MB_S could reach MAX_JOB_MB, or MemAvailable could reach the floor."""
    headroom = min(MAX_JOB_MB - max(biggest, RENICE_MB), avail - MIN_AVAIL_MB)
    return max(MIN_SLEEP, headroom / GROWTH_MB_S)


def main(argv=()):
    if any(a in ("-h", "--help") for a in argv):
        print(usage())
        return 0
    lock = open(f"{STATE}/mem-guard.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0  # already running
    os.nice(5)
    signal.signal(signal.SIGCHLD, signal.SIG_IGN)  # reap notify children
    log(f"start memtotal={MEMTOTAL_MB}MB renice={RENICE_MB}MB maxjob={MAX_JOB_MB}MB "
        f"minavail={MIN_AVAIL_MB}MB minvictim={MIN_VICTIM_MB}MB")
    last_sample = 0.0
    reniced = set()
    while True:
        m = meminfo()
        avail, swap_free, swap_total = m["MemAvailable"], m["SwapFree"], m["SwapTotal"]
        now = time.time()
        if now - last_sample >= 30:
            log(f"sample avail={avail}MB swapfree={swap_free}/{swap_total}MB")
            last_sample = now
        big = set()
        biggest = 0
        for size, pid, cmd in jobs(RENICE_MB):
            if size >= MAX_JOB_MB:
                kill(size, pid, cmd, f"job over {MAX_JOB_MB} MB, avail={avail}MB")
                continue
            if pid not in reniced and not any(p in cmd for p in NO_RENICE_ARG):
                renice(pid, size, cmd)
            big.add(pid)
            biggest = max(biggest, size)
        reniced = big
        if avail < MIN_AVAIL_MB:
            cands = sorted(jobs(MIN_VICTIM_MB), reverse=True)
            if cands:
                kill(*cands[0], f"low memory, avail={avail}MB swapfree={swap_free}MB")
                time.sleep(2)
                continue
        time.sleep(pause(avail, biggest))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
